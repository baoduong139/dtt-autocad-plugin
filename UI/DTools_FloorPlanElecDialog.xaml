<Window x:Class="DTT_AutoCAD_Plugin.UI.DTools_FloorPlanElecDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vẽ Mặt Bằng Điện 2D Full Tính Năng - DTools Pro" 
        Height="680" Width="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- MODERN SHADOWS & GLOWS -->
        <DropShadowEffect x:Key="WindowShadow" BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.30"/>
        <DropShadowEffect x:Key="GlowCyan" BlurRadius="10" ShadowDepth="0" Color="#0284C7" Opacity="0.45"/>

        <!-- STYLE TAB HEADER -->
        <Style x:Key="StyleTabBtn" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" BorderThickness="0,0,0,2.5" BorderBrush="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0284C7"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="Bd" Property="Background" Value="#E0F2FE"/>
                                <Setter Property="Foreground" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE TEXTBOX INPUT -->
        <Style x:Key="StyleInputBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="Border" Property="Effect" Value="{StaticResource GlowCyan}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyleCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- KHUNG CHÍNH (STUDIO CARD) -->
    <Border CornerRadius="12" Background="#F8FAFC" BorderBrush="#0284C7" BorderThickness="1.5" Effect="{StaticResource WindowShadow}" Margin="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/> <!-- HEADER -->
                <RowDefinition Height="42"/> <!-- TABS -->
                <RowDefinition Height="*"/>  <!-- CONTENT -->
                <RowDefinition Height="60"/> <!-- FOOTER -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER (DRAG HANDLE) -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1.2" CornerRadius="11,11,0,0" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="6" Background="#0284C7" Margin="0,0,10,0">
                            <TextBlock Text="🏠" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="VẼ MẶT BẰNG ĐIỆN 2D FULL TÍNH NĂNG (PRO M&amp;E FLOOR PLAN)" FontSize="13" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Chiếu Sáng • Ổ Cắm • Điện Nhẹ ELV • Đi Dây Loop • Tự Động Rải Thiết Bị &amp; Tủ DB" FontSize="9.5" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Click="BtnClose_Click" Width="30" Height="30" Cursor="Hand" Background="Transparent" BorderThickness="0">
                        <TextBlock Text="✖" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. TABS BAR -->
            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1.2" Padding="14,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabRoom" Content="📐 1. Hình Dáng &amp; Tường" Style="{StaticResource StyleTabBtn}" IsChecked="True" Click="Tab_Click" Tag="PanelRoom"/>
                    <RadioButton x:Name="TabLight" Content="💡 2. Chiếu Sáng (Lux)" Style="{StaticResource StyleTabBtn}" Click="Tab_Click" Tag="PanelLight"/>
                    <RadioButton x:Name="TabPower" Content="🔌 3. Ổ Cắm &amp; Động Lực" Style="{StaticResource StyleTabBtn}" Click="Tab_Click" Tag="PanelPower"/>
                    <RadioButton x:Name="TabElv" Content="🌐 4. Điện Nhẹ ELV" Style="{StaticResource StyleTabBtn}" Click="Tab_Click" Tag="PanelElv"/>
                    <RadioButton x:Name="TabWiring" Content="⚡ 5. Đi Dây &amp; Tủ DB" Style="{StaticResource StyleTabBtn}" Click="Tab_Click" Tag="PanelWiring"/>
                </StackPanel>
            </Border>

            <!-- 3. CONTENT: SPLIT 2 CỘT (INPUTS BÊN TRÁI + LIVE PREVIEW BÊN PHẢI) -->
            <Grid Grid.Row="2" Margin="14,10,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="440"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: CÁC TAB THÔNG SỐ -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <!-- TAB 1: HÌNH DÁNG & TƯỜNG -->
                        <StackPanel x:Name="PanelRoom" Visibility="Visible">
                            <TextBlock Text="📐 HÌNH DÁNG PHÒNG &amp; KÍCH THƯỚC TƯỜNG" FontSize="11.5" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,8"/>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Hình dáng phòng:" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="CboShape" Height="30" FontSize="11" SelectionChanged="Parameter_Changed">
                                        <ComboBoxItem Content="Phòng chữ nhật chuẩn" IsSelected="True"/>
                                        <ComboBoxItem Content="Phòng chữ L (Có nhánh)"/>
                                        <ComboBoxItem Content="Phòng chữ T"/>
                                        <ComboBoxItem Content="Pick Polyline trên bản vẽ"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tên không gian / phòng:" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtRoomName" Text="PHÒNG LÀM VIỆC CHÍNH" Style="{StaticResource StyleInputBox}" TextChanged="Parameter_Changed"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Chiều dài phòng L (mm):" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtRoomL" Text="6000" Style="{StaticResource StyleInputBox}" TextChanged="Parameter_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Chiều rộng phòng W (mm):" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtRoomW" Text="4000" Style="{StaticResource StyleInputBox}" TextChanged="Parameter_Changed"/>
                                </StackPanel>
                            </Grid>

                            <!-- THÔNG SỐ NHÁNH PHÒNG CHỮ L & T -->
                            <Border x:Name="BorderBranchElec" Visibility="Collapsed" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="📐 Kích thước nhánh phụ (Chữ L / T):" FontSize="10.5" FontWeight="SemiBold" Foreground="#1E40AF" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Dài nhánh bL (mm):" FontSize="10" Foreground="#475569" Margin="0,0,0,2"/>
                                            <TextBox x:Name="TxtBranchL" Text="3000" Style="{StaticResource StyleInputBox}" TextChanged="Parameter_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Rộng nhánh bW (mm):" FontSize="10" Foreground="#475569" Margin="0,0,0,2"/>
                                            <TextBox x:Name="TxtBranchW" Text="2000" Style="{StaticResource StyleInputBox}" TextChanged="Parameter_Changed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Độ dày tường bao (mm):" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="CboWallT" Height="30" FontSize="11" SelectionChanged="Parameter_Changed">
                                        <ComboBoxItem Content="220 mm (Tường đôi)" IsSelected="True"/>
                                        <ComboBoxItem Content="110 mm (Tường đơn)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Chiều cao trần (mm):" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtCeilingH" Text="2800" Style="{StaticResource StyleInputBox}" TextChanged="Parameter_Changed"/>
                                </StackPanel>
                            </Grid>

                            <Separator Background="#E2E8F0" Margin="0,6,0,8"/>
                            <TextBlock Text="🚪 CỬA ĐI &amp; CỬA SỔ" FontSize="11.5" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Loại cửa đi:" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="CboDoor" Height="30" FontSize="11" SelectionChanged="Parameter_Changed">
                                        <ComboBoxItem Content="Cửa đi 1 cánh D900" IsSelected="True"/>
                                        <ComboBoxItem Content="Cửa đi 2 cánh D1200"/>
                                        <ComboBoxItem Content="Cửa lùa D1000"/>
                                    </ComboBox>
                                    <CheckBox x:Name="ChkDoor" Content="Trổ Cửa Đi Vào Phòng" IsChecked="True" Style="{StaticResource StyleCheckBox}" Margin="0,4,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Click="Parameter_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cửa sổ thông gió:" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtWinW" Text="1500" Style="{StaticResource StyleInputBox}" TextChanged="Parameter_Changed"/>
                                    <CheckBox x:Name="ChkWindow" Content="Trổ Cửa Sổ (Rộng 1500mm)" IsChecked="True" Style="{StaticResource StyleCheckBox}" Margin="0,4,0,0" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Click="Parameter_Changed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- TAB 2: CHIẾU SÁNG (LIGHTING) -->
                        <StackPanel x:Name="PanelLight" Visibility="Collapsed">
                            <TextBlock Text="💡 BỐ TRÍ HỆ THỐNG CHIẾU SÁNG &amp; TÍNH LUX" FontSize="11.5" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Loại đèn chiếu sáng:" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="CboLightType" Height="30" FontSize="11" SelectionChanged="Parameter_Changed">
                                        <ComboBoxItem Content="Đèn Downlight LED âm trần 12W" IsSelected="True"/>
                                        <ComboBoxItem Content="Đèn Panel LED 600x600 48W"/>
                                        <ComboBoxItem Content="Đèn Tuýp LED đôi 1.2m"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Độ rọi Lux thiết kế (E):" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtTargetLux" Text="400" Style="{StaticResource StyleInputBox}" TextChanged="Parameter_Changed"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="ChkAutoLux" Content="Tự động tính số lượng đèn theo diện tích &amp; Lux" IsChecked="True" Style="{StaticResource StyleCheckBox}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Click="Parameter_Changed"/>
                            <CheckBox x:Name="ChkExitLight" Content="Bố trí Đèn EXIT thoát hiểm tại vị trí cửa" IsChecked="True" Style="{StaticResource StyleCheckBox}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Click="Parameter_Changed"/>
                        </StackPanel>

                        <!-- TAB 3: Ổ CẮM & ĐỘNG LỰC -->
                        <StackPanel x:Name="PanelPower" Visibility="Collapsed">
                            <TextBlock Text="🔌 HỆ THỐNG Ổ CẮM &amp; THIẾT BỊ ĐỘNG LỰC" FontSize="11.5" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkSocketPerimeter" Content="Tự động rải ổ cắm đôi dọc chu vi chân tường" IsChecked="True" Style="{StaticResource StyleCheckBox}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Click="Parameter_Changed"/>
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Khoảng cách giữa các ổ cắm (mm):" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TxtSocketSpacing" Text="2500" Style="{StaticResource StyleInputBox}" TextChanged="Parameter_Changed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cao độ ổ cắm (mm):" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                    <TextBox Text="+300 mm" Style="{StaticResource StyleInputBox}" IsReadOnly="True" Background="#F1F5F9"/>
                                </StackPanel>
                            </Grid>
                            <Separator Background="#E2E8F0" Margin="0,4,0,8"/>
                            <TextBlock Text="⚡ THIẾT BỊ CÔNG SUẤT LỚN RIÊNG BIỆT" FontSize="11" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkAcUnit" Content="Điều hòa nhiệt độ AC (H=+2400mm kèm lộ riêng N3)" IsChecked="True" Style="{StaticResource StyleCheckBox}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Click="Parameter_Changed"/>
                            <CheckBox x:Name="ChkCeilingFan" Content="Quạt trần tâm phòng (Ceiling Fan)" IsChecked="False" Style="{StaticResource StyleCheckBox}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Click="Parameter_Changed"/>
                            <CheckBox x:Name="ChkWaterHeater" Content="Bình nước nóng lạnh (H=+2000mm kèm RCBO chống giật)" IsChecked="False" Style="{StaticResource StyleCheckBox}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Click="Parameter_Changed"/>
                        </StackPanel>

                        <!-- TAB 4: ĐIỆN NHẸ ELV -->
                        <StackPanel x:Name="PanelElv" Visibility="Collapsed">
                            <TextBlock Text="🌐 HỆ THỐNG ĐIỆN NHẸ (ELV &amp; AN NINH)" FontSize="11.5" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkDataLan" Content="Ổ cắm mạng dữ liệu LAN Cat6 RJ45 (H=+300mm)" IsChecked="True" Style="{StaticResource StyleCheckBox}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Click="Parameter_Changed"/>
                            <CheckBox x:Name="ChkTvOutlet" Content="Ổ cắm truyền hình Tivi cáp đồng trục (H=+600mm)" IsChecked="True" Style="{StaticResource StyleCheckBox}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Click="Parameter_Changed"/>
                            <CheckBox x:Name="ChkSmoke" Content="Đầu báo khói quang điện gắn trần (PCCC)" IsChecked="True" Style="{StaticResource StyleCheckBox}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Click="Parameter_Changed"/>
                            <CheckBox x:Name="ChkCamera" Content="Camera an ninh IP Dome bán cầu góc phòng" IsChecked="True" Style="{StaticResource StyleCheckBox}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Click="Parameter_Changed"/>
                        </StackPanel>

                        <!-- TAB 5: ĐI DÂY & TỦ DB -->
                        <StackPanel x:Name="PanelWiring" Visibility="Collapsed">
                            <TextBlock Text="⚡ QUY CÁCH ĐI DÂY &amp; TỦ PHÂN PHỐI DB" FontSize="11.5" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Kiểu đường dây:" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="CboWiringStyle" Height="30" FontSize="11" SelectionChanged="Parameter_Changed">
                                        <ComboBoxItem Content="Đường cong Arc Bezier (Chuẩn MEP)" IsSelected="True"/>
                                        <ComboBoxItem Content="Đường gấp khúc Orthogonal"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Công tắc cửa:" FontSize="10.5" Foreground="#475569" Margin="0,0,0,2"/>
                                    <ComboBox x:Name="CboSwitchGangs" Height="30" FontSize="11" SelectionChanged="Parameter_Changed">
                                        <ComboBoxItem Content="Công tắc 1 hạt (S1)"/>
                                        <ComboBoxItem Content="Công tắc 2 hạt (S2)" IsSelected="True"/>
                                        <ComboBoxItem Content="Công tắc 3 hạt (S3)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="ChkHomeRun" Content="Vẽ mũi tên Home-run chỉ tuyến dây về Tủ DB" IsChecked="True" Style="{StaticResource StyleCheckBox}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Click="Parameter_Changed"/>
                            <CheckBox x:Name="ChkPlaceDb" Content="Chèn Block Tủ Điện Tổng (DB-01) liên kết Module Vạn Năng" IsChecked="True" Style="{StaticResource StyleCheckBox}" Checked="Parameter_Changed" Unchecked="Parameter_Changed" Click="Parameter_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- CỘT PHẢI: LIVE VECTOR PREVIEW CANVAS -->
                <Border Grid.Column="2" CornerRadius="8" Background="#0F172A" BorderBrush="#334155" BorderThickness="1.5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <!-- PREVIEW HEADER -->
                        <Border Grid.Row="0" Background="#1E293B" CornerRadius="7,7,0,0" Padding="8,0">
                            <Grid VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="👁️ XEM TRƯỚC (LIVE PREVIEW)" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="BtnZoomOut" Content="➖" Width="24" Height="22" Background="#334155" Foreground="White" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand" Click="BtnZoomOut_Click" ToolTip="Thu nhỏ"/>
                                    <TextBlock x:Name="TxtZoomLevel" Text="100%" FontSize="9.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="2,0,4,0" MinWidth="34" TextAlignment="Center"/>
                                    <Button x:Name="BtnZoomIn" Content="➕" Width="24" Height="22" Background="#334155" Foreground="White" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand" Click="BtnZoomIn_Click" ToolTip="Phóng to"/>
                                    <Button x:Name="BtnZoomReset" Content="⟲ Fit" Width="36" Height="22" Background="#334155" Foreground="White" BorderThickness="0" Margin="0,0,6,0" Cursor="Hand" Click="BtnZoomReset_Click" ToolTip="Đặt lại kích thước vừa khung"/>
                                    <Button x:Name="BtnToggle3d" Content="🧊 3D ISO" Width="64" Height="22" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="9.5" BorderThickness="0" Cursor="Hand" Click="BtnToggle3d_Click" ToolTip="Chuyển chế độ xem Không Gian 3D / Mặt Bằng 2D"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- PREVIEW CANVAS -->
                        <Canvas Grid.Row="1" x:Name="PreviewCanvas" ClipToBounds="True" Background="#0B132B" SizeChanged="PreviewCanvas_SizeChanged"
                                MouseWheel="PreviewCanvas_MouseWheel" MouseLeftButtonDown="PreviewCanvas_MouseDown" MouseMove="PreviewCanvas_MouseMove" MouseLeftButtonUp="PreviewCanvas_MouseUp" Cursor="Hand"/>

                        <!-- PREVIEW FOOTER -->
                        <Border Grid.Row="2" Background="#1E293B" CornerRadius="0,0,7,7" Padding="10,0">
                            <TextBlock x:Name="TxtPreviewInfo" Text="Phòng: 6000 x 4000 mm | 6 Đèn Downlight | 6 Ổ cắm | 1 AC | Tủ DB-01" FontSize="9.5" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. FOOTER ACTION BUTTONS -->
            <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1.2,0,0" CornerRadius="0,0,11,11" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock Text="💡 Bấm " FontSize="11" Foreground="#64748B"/>
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="4,1">
                            <TextBlock Text="ENTER" FontSize="10" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                        <TextBlock Text=" để vẽ ngay | " FontSize="11" Foreground="#64748B"/>
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="3" Padding="4,1">
                            <TextBlock Text="ESC" FontSize="10" FontWeight="Bold" Foreground="#0284C7"/>
                        </Border>
                        <TextBlock Text=" hủy bỏ" FontSize="11" Foreground="#64748B"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="BtnCancel_Click" Width="100" Height="34" Margin="0,0,10,0" Cursor="Hand" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <TextBlock Text="✖ Hủy Bỏ (Esc)" FontSize="11" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="BtnExportBom_Click" Width="150" Height="34" Margin="0,0,10,0" Cursor="Hand" Background="#16A34A" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="📊 " FontSize="13" Foreground="#FFFFFF"/>
                                            <TextBlock Text="XUẤT BOM EXCEL" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Click="BtnBuild_Click" Width="220" Height="34" Cursor="Hand" Background="#0284C7" BorderThickness="0" Effect="{StaticResource GlowCyan}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ " FontSize="14" Foreground="#FFFFFF"/>
                                            <TextBlock Text="VẼ MẶT BẰNG NGAY [ENTER]" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
