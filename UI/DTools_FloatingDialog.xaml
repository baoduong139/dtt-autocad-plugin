<Window x:Class="DTT_AutoCAD_Plugin.UI.DTools_FloatingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DTools Pro - Nhập Thông Số &amp; Xem Trước"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        MinWidth="540" MaxWidth="620"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- HIỆU ỨNG ĐỔ BÓNG NỔI HIỆN ĐẠI -->
    <Border Margin="14" CornerRadius="12" Background="#FFFFFF" BorderBrush="#0284C7" BorderThickness="1.8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Color="#0284C7" Opacity="0.35"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/> <!-- HEADER KÉO THẢ -->
                <RowDefinition Height="*"/>  <!-- BODY CHÍNH (INPUT + PREVIEW) -->
                <RowDefinition Height="54"/> <!-- FOOTER (NÚT BẤM + PHÍM TẮT) -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER (DRAGGABLE HANDLE) -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0" Padding="14,0" MouseDown="Header_MouseDown" Cursor="SizeAll">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0284C7" Offset="0.0"/>
                        <GradientStop Color="#0EA5E9" Offset="0.6"/>
                        <GradientStop Color="#38BDF8" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtIcon" Text="⚡" FontSize="16" Foreground="#FFFFFF" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TxtTitle" Text="NHẬP THÔNG SỐ VẼ" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border Background="#E0F2FE" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DTools Pro v3.5" FontSize="8.5" FontWeight="Bold" Foreground="#0369A1"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtSubtitle" Text="Nhập số trực tiếp (Enter để hoàn tất, Tab chuyển ô, Esc để hủy)" FontSize="9" Foreground="#E0F2FE" Margin="24,1,0,0"/>
                    </StackPanel>

                    <!-- Nút Đóng [X] -->
                    <Button Grid.Column="1" Content="✕" Width="30" Height="30" VerticalAlignment="Center"
                            Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="14" FontWeight="Bold"
                            Cursor="Hand" Click="BtnCancel_Click" ToolTip="Đóng (Esc)"/>
                </Grid>
            </Border>

            <!-- 2. BODY (CỘT TRÁI: Ô NHẬP LIỆU | CỘT PHẢI: XEM TRƯỚC PREVIEW) -->
            <Grid Grid.Row="1" Margin="16,14,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="230"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: DANH SÁCH Ô NHẬP LIỆU DYNAMIC -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,14,0" MaxHeight="320">
                    <StackPanel x:Name="PanelInputs">
                        <!-- Các trường nhập liệu sẽ được sinh tự động tại đây -->
                    </StackPanel>
                </ScrollViewer>

                <!-- CỘT PHẢI: KHUNG XEM TRƯỚC (LIVE INTERACTIVE PREVIEW) -->
                <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1.2" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tiêu đề Preview -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,6">
                            <TextBlock Text="👁️ " FontSize="11"/>
                            <TextBlock Text="XEM TRƯỚC MÔ HÌNH" FontSize="10" FontWeight="Bold" Foreground="#0284C7"/>
                        </StackPanel>

                        <!-- Canvas vẽ hình Preview -->
                        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" MinHeight="170" ClipToBounds="True">
                            <Canvas x:Name="PreviewCanvas" Width="210" Height="170" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Ghi chú dưới Preview -->
                        <TextBlock Grid.Row="2" x:Name="TxtPreviewNote" Text="Hình vẽ tự động cập nhật theo thông số" 
                                   FontSize="8.5" Foreground="#64748B" TextWrapping="Wrap" Margin="2,6,2,0" TextAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. FOOTER (HƯỚNG DẪN PHÍM TẮT & NÚT BẤM THỰC THI) -->
            <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="0,0,10,10" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hướng dẫn phím tắt -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="⌨ Phím tắt tiện lợi:" FontSize="9.5" FontWeight="Bold" Foreground="#475569"/>
                        <TextBlock Text="[ENTER] = Áp dụng &amp; Vẽ  |  [TAB] = Chuyển ô  |  [ESC] = Hủy bỏ" FontSize="9" Foreground="#64748B" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Nút Hủy & Nút Áp Dụng -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Hủy (Esc)" Width="85" Height="34" Margin="0,0,10,0"
                                Background="#E2E8F0" Foreground="#334155" FontWeight="SemiBold"
                                BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" Click="BtnCancel_Click"/>

                        <Button x:Name="BtnApply" Content="✔ ÁP DỤNG &amp; VẼ (ENTER)" Width="185" Height="34"
                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand" Click="BtnApply_Click">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="270" Color="#0284C7" Opacity="0.4"/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
