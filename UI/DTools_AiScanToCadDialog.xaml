<Window x:Class="DTT_AutoCAD_Plugin.UI.DTools_AiScanToCadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DTools Pro - Quét Bản Vẽ (Ảnh/PDF) Ra CAD (AI Vision)"
        Height="700" Width="1040"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Border Margin="14" CornerRadius="12" Background="#FFFFFF" BorderBrush="#0284C7" BorderThickness="1.8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="5" Direction="270" Color="#0284C7" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- 1. HEADER (DRAGGABLE) -->
            <Border Grid.Row="0" CornerRadius="10,10,0,0" Padding="16,0" MouseDown="Header_MouseDown" Cursor="SizeAll">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0284C7" Offset="0.0"/>
                        <GradientStop Color="#0EA5E9" Offset="0.6"/>
                        <GradientStop Color="#38BDF8" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🤖" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DTOOLS AI RASTER-TO-CAD &amp; VISION VECTORIZER" FontSize="13.5" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                                <Border Background="#E0F2FE" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="PRO AI 2026" FontSize="8.5" FontWeight="Bold" Foreground="#0369A1"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Quét ảnh chụp / scan / PDF bản vẽ và tự động dựng lại nét CAD (DWG) bằng AI Vision &amp; Computer Vision" FontSize="10" FontWeight="SemiBold" Foreground="#E0F2FE"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Content="✕" Width="32" Height="32" VerticalAlignment="Center"
                            Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="14" FontWeight="Bold"
                            Cursor="Hand" Click="BtnCancel_Click" ToolTip="Đóng (Esc)"/>
                </Grid>
            </Border>

            <!-- 2. BODY CONTENT (2 CỘT) -->
            <Grid Grid.Row="1" Margin="14,10,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: ĐIỀU KHIỂN & CẤU HÌNH -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                    <StackPanel>
                        <!-- CHỌN FILE ẢNH/PDF -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="📁 TỆP ẢNH / BẢN VẼ SCAN:" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtFilePath" Height="30" FontSize="11" Padding="6,4" Background="#FFFFFF" BorderBrush="#94A3B8"
                                             Text="Chọn file ảnh PNG, JPG hoặc PDF..." IsReadOnly="True" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Chọn File..." Width="80" Height="30" Margin="6,0,0,0"
                                            Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11" BorderThickness="0"
                                            Cursor="Hand" Click="BtnBrowse_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CHỌN CHẾ ĐỘ XỬ LÝ -->
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1.2" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="⚙️ PHƯƠNG THỨC XỬ LÝ:" FontSize="11.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8"/>
                                <RadioButton x:Name="RbComputerVision" Content="⚡ Computer Vision Vectorizer (Quét Nét Trực Tiếp Siêu Tốc)" 
                                             IsChecked="True" FontWeight="Bold" FontSize="11.5" Foreground="#0284C7" Margin="0,0,0,6" Checked="Mode_Changed"/>
                                <RadioButton x:Name="RbOllamaVision" Content="🤖 AI Vision LLM (Ollama llama3.2-vision / JSON Semantic)" 
                                             FontWeight="Bold" FontSize="11.5" Foreground="#7C3AED" Margin="0,0,0,8" Checked="Mode_Changed"/>

                                <!-- THÔNG SỐ CHO COMPUTER VISION -->
                                <StackPanel x:Name="PanelCvSettings">
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Tỉ lệ quy đổi (1 px = ... mm):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtScaleMm" Grid.Column="1" Text="15.0" Height="26" FontSize="11" FontWeight="Bold" Padding="4,2" HorizontalContentAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Ngưỡng nhị phân nét (0-255):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtThreshold" Grid.Column="1" Text="160" Height="26" FontSize="11" FontWeight="Bold" Padding="4,2" HorizontalContentAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Độ dài nét tối thiểu (px):" FontSize="11" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtMinLength" Grid.Column="1" Text="25" Height="26" FontSize="11" FontWeight="Bold" Padding="4,2" HorizontalContentAlignment="Center"/>
                                    </Grid>
                                    <CheckBox x:Name="ChkOrthoSnap" Content="Tự động nắn góc vuông 0°, 90° (Ortho Snap)" IsChecked="True" FontWeight="Bold" FontSize="11" Foreground="#0F172A" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- THÔNG SỐ CHO OLLAMA VISION -->
                                <StackPanel x:Name="PanelOllamaSettings" Visibility="Collapsed">
                                    <TextBlock Text="Ollama Endpoint URL:" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,2"/>
                                    <TextBox x:Name="TxtOllamaUrl" Text="http://localhost:11434/api/generate" Height="26" FontSize="10.5" Padding="4,2" Margin="0,0,0,4"/>
                                    
                                    <TextBlock Text="Tên mô hình Vision:" FontSize="10.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,2"/>
                                    <ComboBox x:Name="CboOllamaModel" Height="28" FontSize="11" FontWeight="Bold" IsEditable="True" Margin="0,0,0,6"/>

                                    <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="0,0,0,6">
                                        <TextBlock Text="💡 Cần mô hình Vision (như llama3.2-vision, llava). Nếu chưa có, chọn 'Computer Vision Vectorizer' ở trên để quét ngay!"
                                                   FontSize="9.5" FontWeight="SemiBold" Foreground="#92400E" TextWrapping="Wrap"/>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                        <Button Content="🤖 Gửi Ảnh Tới Ollama" Width="145" Height="28" Background="#7C3AED" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10.5" BorderThickness="0" Cursor="Hand" Click="BtnCallOllama_Click" Margin="0,0,6,0"/>
                                        <Button Content="📋 Dán JSON Từ Clipboard" Width="150" Height="28" Background="#0284C7" Foreground="#FFFFFF" FontWeight="Bold" FontSize="10.5" BorderThickness="0" Cursor="Hand" Click="BtnPasteJson_Click"/>
                                    </StackPanel>

                                    <TextBlock Text="Dữ liệu JSON Vectors:" FontSize="10" Foreground="#475569" Margin="0,2,0,2"/>
                                    <TextBox x:Name="TxtJsonInput" Height="90" FontSize="9.5" FontFamily="Consolas" Padding="4"
                                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                             Text="Dán JSON cấu trúc Ollama vào đây hoặc bấm 'Gửi Ảnh Tới Ollama'..."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- NÚT PHÂN TÍCH -->
                        <Button Content="⚡ BẮT ĐẦU PHÂN TÍCH &amp; VECTOR HÓA" Height="38"
                                Background="#0284C7" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="12.5"
                                BorderThickness="0" Cursor="Hand" Click="BtnAnalyze_Click"/>

                        <Button Content="📋 Sao Chép System Prompt Ollama Chuẩn" Height="28" Margin="0,6,0,0"
                                Background="#F1F5F9" Foreground="#0F172A" FontWeight="SemiBold" FontSize="10"
                                BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand" Click="BtnCopyPrompt_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- CỘT PHẢI: LIVE VECTOR PREVIEW CANVAS -->
                <Border Grid.Column="1" Background="#0F172A" CornerRadius="10" BorderBrush="#334155" BorderThickness="1.5" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <!-- PREVIEW HEADER -->
                        <Border Grid.Row="0" Background="#1E293B" Padding="10,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📐 XEM TRƯỚC VECTƠ (LIVE VECTOR PREVIEW)" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="➕" Width="26" Height="22" Background="#334155" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="BtnZoomIn_Click" Margin="0,0,4,0"/>
                                    <Button Content="➖" Width="26" Height="22" Background="#334155" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="BtnZoomOut_Click" Margin="0,0,4,0"/>
                                    <Button Content="⟲ Reset" Height="22" Padding="6,0" Background="#334155" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="BtnZoomReset_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- CANVAS VẼ NÉT -->
                        <Canvas Grid.Row="1" x:Name="PreviewCanvas" ClipToBounds="True" Background="#0F172A"/>

                        <!-- PREVIEW FOOTER STATS -->
                        <Border Grid.Row="2" Background="#1E293B" Padding="10,0">
                            <TextBlock x:Name="TxtStats" Text="Sẵn sàng quét ảnh. Vui lòng chọn file ảnh và bấm 'Bắt đầu phân tích'."
                                       FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. FOOTER (ACTIONS) -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1.5,0,0" Padding="16,0" CornerRadius="0,0,10,10">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="💡 Gợi ý: Click điểm đặt trên bản vẽ CAD để chèn toàn bộ nét sau khi bấm 'Dựng Vào AutoCAD'."
                               FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="✕ Hủy Bỏ (Esc)" Width="100" Height="34" Margin="0,0,8,0"
                                Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1.2"
                                Foreground="#475569" FontWeight="Bold" FontSize="11" Cursor="Hand" Click="BtnCancel_Click"/>

                        <Button x:Name="BtnInjectCad" Content="🏛️ DỰNG VÀO AUTOCAD NGAY (DWG)" Width="230" Height="34"
                                Background="#10B981" Foreground="#FFFFFF" FontWeight="ExtraBold" FontSize="11.5"
                                BorderThickness="0" Cursor="Hand" Click="BtnInjectCad_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
