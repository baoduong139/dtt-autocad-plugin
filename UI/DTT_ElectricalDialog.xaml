<Window x:Class="DTT_AutoCAD_Plugin.UI.DTT_ElectricalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thư Viện Ký Hiệu Thiết Bị Điện" 
        Height="470" Width="530"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Tahoma, sans-serif">

    <Border CornerRadius="12" Background="#FFFFFF" BorderBrush="#0284C7" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Color="#64748B" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/> <!-- HEADER -->
                <RowDefinition Height="*"/>  <!-- BODY -->
                <RowDefinition Height="54"/> <!-- FOOTER -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER (DRAGGABLE) -->
            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="11,11,0,0" Padding="14,0" MouseDown="Header_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="16" Foreground="#0284C7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="THƯ VIỆN KÝ HIỆU &amp; THIẾT BỊ ĐIỆN PRO" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right" Background="Transparent" Foreground="#64748B" BorderThickness="0" FontSize="14" Cursor="Hand" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- 2. BODY -->
            <Grid Grid.Row="1" Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CỘT TRÁI: DANH MỤC THIẾT BỊ -->
                <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="6">
                    <StackPanel>
                        <TextBlock Text="CHỌN NHÓM THIẾT BỊ" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="4,2,0,6"/>
                        <ListBox x:Name="ListCategories" Background="Transparent" BorderThickness="0" SelectionChanged="ListCategories_SelectionChanged">
                            <ListBoxItem Content="🔌 Ổ Cắm Điện" IsSelected="True" Foreground="#0F172A" Padding="8,6" Cursor="Hand"/>
                            <ListBoxItem Content="💡 Đèn Chiếu Sáng" Foreground="#0F172A" Padding="8,6" Cursor="Hand"/>
                            <ListBoxItem Content="🔘 Công Tắc Điện" Foreground="#0F172A" Padding="8,6" Cursor="Hand"/>
                            <ListBoxItem Content="⚡ Tủ Điện &amp; Bảo Vệ" Foreground="#0F172A" Padding="8,6" Cursor="Hand"/>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- CỘT PHẢI: CHI TIẾT THIẾT BỊ & THÔNG SỐ -->
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="LOẠI THIẾT BỊ CỤ THỂ:" FontSize="10.5" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbDevices" Height="30" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" FontWeight="SemiBold" SelectionChanged="CmbDevices_SelectionChanged" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="CAO ĐỘ ĐẶT (mm):" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtHeight" Text="300" Height="28" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="TỈ LỆ BẢN VẼ:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <ComboBox x:Name="CmbScale" Height="28" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" SelectedIndex="0">
                                <ComboBoxItem Content="1 : 1 (Thực tế)"/>
                                <ComboBoxItem Content="1 : 50"/>
                                <ComboBoxItem Content="1 : 100"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="QUY CÁCH / CÔNG SUẤT:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtSpec" Text="16A - 250V" Height="28" Background="#FFFFFF" Foreground="#0F172A" BorderBrush="#CBD5E1" Padding="6,4" Margin="0,0,0,10"/>

                    <!-- KHUNG MÔ TẢ PREVIEW -->
                    <Border Background="#F0F9FF" CornerRadius="6" BorderBrush="#BAE6FD" BorderThickness="1" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="TxtPreviewName" Text="Ổ Cắm Đôi 16A" FontSize="12" FontWeight="Bold" Foreground="#0284C7"/>
                            <TextBlock x:Name="TxtPreviewDesc" Text="Lắp đặt tường cao độ H=+300mm. Ký hiệu nửa vòng tròn đôi chuẩn TCVN." FontSize="10.5" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 3. FOOTER -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,11,11" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="💡 Bấm chèn rồi click vị trí trên AutoCAD" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Hủy" Width="70" Height="32" Margin="0,0,8,0" Background="#F1F5F9" Foreground="#64748B" BorderThickness="1" BorderBrush="#CBD5E1" Cursor="Hand" Click="Close_Click"/>
                        <Button Content="👉 CHÈN VÀO BẢN VẼ" Width="170" Height="32" FontWeight="Bold" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="Insert_Click">
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#0284C7" Opacity="0.35"/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
