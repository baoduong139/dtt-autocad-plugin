                        <Button Style="{StaticResource Style3DButton}" Click="Btn_Click" Tag="_SUBTRACT ">
                            <TextBlock><Run Text="➖ " Foreground="#f87171"/><Run Text="Trừ Khối Đục Lỗ (_SUBTRACT)"/></TextBlock>
                        </Button>
                        <Button Style="{StaticResource Style3DButton}" Click="Btn_Click" Tag="_INTERSECT ">
                            <TextBlock><Run Text="✖ " Foreground="#fbbf24"/><Run Text="Giao Khối 3D (_INTERSECT)"/></TextBlock>
                        </Button>
                        <Button Style="{StaticResource Style3DButton}" Click="Btn_Click" Tag="_SLICE ">
                            <TextBlock><Run Text="🔪 " Foreground="#f97316"/><Run Text="Cắt Khối Solid (_SLICE)"/></TextBlock>
                        </Button>
                    </StackPanel>

                    <!-- ============================================================
                         TAB 10: ⚙️ CÀI ĐẶT &amp; TÙY BIẾN
                         ============================================================ -->
                    <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                        <TextBlock Text="⚙️ CÀI ĐẶT HỆ THỐNG DTT PRO" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}" Margin="2,4,0,8"/>

                        <!-- CỠ CHỮ GIAO DIỆN -->
                        <Border CornerRadius="8" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Background="{DynamicResource ThemeCardBg}" Padding="12" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.15"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🔤 " FontSize="13" Foreground="{DynamicResource ThemeAccent}"/>
                                    <TextBlock Text="CỠ CHỮ GIAO DIỆN:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbFontSize" Style="{StaticResource StyleModernComboBox}" SelectedIndex="1" SelectionChanged="CmbFontSize_SelectionChanged">
                                    <ComboBoxItem Content="Nhỏ (10 px) - Compact Mode"/>
                                    <ComboBoxItem Content="Tiêu Chuẩn (11.5 px) - Normal"/>
                                    <ComboBoxItem Content="Lớn (13.5 px) - Large Mode"/>
                                    <ComboBoxItem Content="Rất Lớn (15 px) - Extra Large"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- CHỦ ĐỀ GIAO DIỆN (THEME) -->
                        <Border CornerRadius="8" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Background="{DynamicResource ThemeCardBg}" Padding="12" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.15"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🌓 " FontSize="13" Foreground="{DynamicResource ThemeAccent}"/>
                                    <TextBlock Text="CHỦ ĐỀ GIAO DIỆN (THEME):" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbTheme" Style="{StaticResource StyleModernComboBox}" SelectedIndex="0" SelectionChanged="CmbTheme_SelectionChanged">
                                    <ComboBoxItem Content="🌑 Dark Slate Pro (Xám Đậm &amp; Xanh Dương Hiện Đại)"/>
                                    <ComboBoxItem Content="☀️ Light Studio (Trắng Sáng &amp; Xanh)"/>
                                    <ComboBoxItem Content="🌌 Cyberpunk Dark (Navy &amp; Neon Cyan)"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- NGÔN NGỮ (LANGUAGE) -->
                        <Border CornerRadius="8" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Background="{DynamicResource ThemeCardBg}" Padding="12" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.15"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🌐 " FontSize="13" Foreground="{DynamicResource ThemeAccent}"/>
                                    <TextBlock Text="NGÔN NGỮ (LANGUAGE):" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbLanguage" Style="{StaticResource StyleModernComboBox}" SelectedIndex="0" SelectionChanged="CmbLanguage_SelectionChanged">
                                    <ComboBoxItem Content="🇻🇳 Tiếng Việt (Vietnamese Standard)"/>
                                    <ComboBoxItem Content="🇬🇧 English (International CAD)"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- QUẢN LÝ HỆ THỐNG & MENUBAR DTOOLS -->
                        <Border CornerRadius="8" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Background="{DynamicResource ThemeCardBg}" Padding="12" Margin="0,0,0,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.15"/>
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="🛠️ " FontSize="13" Foreground="{DynamicResource ThemeAccent}"/>
                                    <TextBlock Text="QUẢN LÝ HỆ THỐNG &amp; MENU DTOOLS:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Style="{StaticResource StyleActionCardBtn}" Click="Btn_Click" Tag="DT_MENU" ToolTip="Cập nhật hoặc hiển thị lại MenuBar 'DTools Pro' trên AutoCAD">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="📋 " FontSize="12"/>
                                            <TextBlock Text="Cập Nhật MenuBar" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource StyleActionCardBtn}" Click="Btn_Click" Tag="DT_YQREFIX" ToolTip="Khôi phục và nạp lại Menu YQArch Tiếng Việt">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="🩺 " FontSize="12"/>
                                            <TextBlock Text="Sửa Lỗi YQArch" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Button Style="{StaticResource StyleActionCardBtnDanger}" Click="Btn_Click" Tag="DT_CLEAN" ToolTip="Dọn dẹp rác, xóa RegApps, nét độ dài 0 và sửa lỗi database">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🧹 " FontSize="12"/>
                                        <TextBlock Text="Dọn Rác &amp; Sửa Lỗi DWG (DT_CLEAN)" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- THÔNG TIN PLUGIN -->
                        <Border CornerRadius="8" BorderBrush="{DynamicResource ThemeControlBorder}" BorderThickness="1" Background="{DynamicResource ThemeControlBg}" Padding="12" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="DTT CAD TOOLSET PRO v2026" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/>
                                <TextBlock Text="Native WPF | AutoCAD 2020-2026 | .NET Framework 4.8" FontSize="9" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0"/>
                                <TextBlock Text="Tất cả chức năng 100% tiếng Việt - Sẵn sàng thực thi 1-Click" FontSize="9" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" x:Name="FooterBorder" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtStatus" Text="⚡ DTools Pro v5.0 - Sẵn sàng thực thi 100% Native CAD" FontSize="10" FontWeight="Medium" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                <Border Grid.Column="1" CornerRadius="10" Padding="8,2" Background="{DynamicResource ThemeAccent}">
                    <TextBlock Text="v5.0 PRO" FontSize="9" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
