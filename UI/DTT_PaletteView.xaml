<UserControl x:Class="DTT_AutoCAD_Plugin.UI.DTT_PaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="360"
             FontFamily="Segoe UI, Tahoma, sans-serif"
             Background="{DynamicResource ThemePaletteBg}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             x:Name="RootPaletteControl">

    <UserControl.Resources>
        <!-- DYNAMIC THEME BRUSHES (SLATE & ACCENT BLUE/CYAN) -->
        <SolidColorBrush x:Key="ThemePaletteBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="ThemeCardBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="ThemeCardBorder" Color="#334155"/>
        <SolidColorBrush x:Key="ThemeTextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ThemeTextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="ThemeAccent" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="ThemeAccentHover" Color="#38BDF8"/>
        <SolidColorBrush x:Key="ThemeControlBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="ThemeControlBorder" Color="#334155"/>
        <SolidColorBrush x:Key="ThemeSidebarBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="ThemeTabNormalText" Color="#64748B"/>
        <SolidColorBrush x:Key="ThemeTabActiveText" Color="#00D2FF"/>
        <SolidColorBrush x:Key="ThemeTabActiveBg" Color="#0F172A"/>

        <!-- DROP SHADOWS -->
        <DropShadowEffect x:Key="ShadowDeep" BlurRadius="6" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.18"/>
        <DropShadowEffect x:Key="GlowCyan" BlurRadius="8" ShadowDepth="0" Color="#0EA5E9" Opacity="0.4"/>
        <DropShadowEffect x:Key="GlowGold" BlurRadius="8" ShadowDepth="0" Color="#F59E0B" Opacity="0.35"/>
        <DropShadowEffect x:Key="GlowGreen" BlurRadius="8" ShadowDepth="0" Color="#10B981" Opacity="0.35"/>
        <DropShadowEffect x:Key="GlowPurple" BlurRadius="8" ShadowDepth="0" Color="#A855F7" Opacity="0.35"/>
        <DropShadowEffect x:Key="GlowRed" BlurRadius="8" ShadowDepth="0" Color="#EF4444" Opacity="0.35"/>

        <!-- STYLE COMBOBOX HIỆN ĐẠI (BO GÓC 6PX, BORDER MẢNH) -->
        <Style x:Key="StyleModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeControlBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" 
                                                CornerRadius="6" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                      Data="M 0 0 L 4 4 L 8 0 Z" 
                                                      Fill="{DynamicResource ThemeTextSecondary}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="true">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ThemeAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="{DynamicResource ThemeCardBg}" 
                                            BorderBrush="{DynamicResource ThemeControlBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Margin="0,2,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.35"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE COMBOBOX ITEM -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE NÚT HÀNH ĐỘNG CARD TRONG SETTINGS (HOVER MƯỢT, BO GÓC 6PX) -->
        <Style x:Key="StyleActionCardBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="6" Background="{DynamicResource ThemeControlBg}" BorderBrush="{DynamicResource ThemeControlBorder}" BorderThickness="1" Padding="6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeAccentHover}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StyleActionCardBtnDanger" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="6" Background="{DynamicResource ThemeControlBg}" BorderBrush="{DynamicResource ThemeControlBorder}" BorderThickness="1" Padding="6,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DC2626"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE NÚT LỆNH TIÊU CHUẨN (LIGHT STUDIO MODERN CARD) -->
        <Style x:Key="Style3DButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,2,0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="BorderOuter" 
                                    CornerRadius="6" 
                                    BorderThickness="1" 
                                    BorderBrush="#CBD5E1"
                                    Background="#FFFFFF"
                                    RenderTransformOrigin="0.5,0.5"
                                    Effect="{StaticResource ShadowDeep}">
                                <Grid Margin="8,0">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderOuter" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="BorderOuter" Property="Background" Value="#F0F9FF"/>
                                <Setter TargetName="BorderOuter" Property="Effect" Value="{StaticResource GlowCyan}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BorderOuter" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1.5"/></Setter.Value>
                                </Setter>
                                <Setter TargetName="BorderOuter" Property="BorderBrush" Value="#0369A1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NÚT VIP CYAN (Mặt Bằng, Điện) -->
        <Style x:Key="StyleVipButton" TargetType="Button" BasedOn="{StaticResource Style3DButton}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="VipBorder" CornerRadius="7" BorderThickness="1.5"
                                BorderBrush="#0284C7" Background="#F0F9FF" RenderTransformOrigin="0.5,0.5"
                                Effect="{StaticResource GlowCyan}">
                            <Grid Margin="10,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="VipBorder" Property="Background" Value="#E0F2FE"/>
                                <Setter TargetName="VipBorder" Property="BorderBrush" Value="#0369A1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="VipBorder" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1.5"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NÚT VIP GOLD (Mặt Cắt, Menu) -->
        <Style x:Key="StyleGoldButton" TargetType="Button" BasedOn="{StaticResource StyleVipButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GoldBorder" CornerRadius="7" BorderThickness="1.5"
                                BorderBrush="#F59E0B" Background="#FFFBEB" RenderTransformOrigin="0.5,0.5"
                                Effect="{StaticResource GlowGold}">
                            <Grid Margin="10,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GoldBorder" Property="Background" Value="#FEF3C7"/>
                                <Setter TargetName="GoldBorder" Property="BorderBrush" Value="#D97706"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GoldBorder" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1.5"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NÚT VIP GREEN (Kết cấu, Tiện ích) -->
        <Style x:Key="StyleGreenButton" TargetType="Button" BasedOn="{StaticResource StyleVipButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GreenBorder" CornerRadius="7" BorderThickness="1.5"
                                BorderBrush="#10B981" Background="#ECFDF5" RenderTransformOrigin="0.5,0.5"
                                Effect="{StaticResource GlowGreen}">
                            <Grid Margin="10,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GreenBorder" Property="Background" Value="#D1FAE5"/>
                                <Setter TargetName="GreenBorder" Property="BorderBrush" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="GreenBorder" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1.5"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NÚT VIP PURPLE (Kết cấu) -->
        <Style x:Key="StylePurpleButton" TargetType="Button" BasedOn="{StaticResource StyleVipButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PurpleBorder" CornerRadius="7" BorderThickness="1.5"
                                BorderBrush="#A855F7" Background="#FAF5FF" RenderTransformOrigin="0.5,0.5"
                                Effect="{StaticResource GlowPurple}">
                            <Grid Margin="10,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PurpleBorder" Property="Background" Value="#F3E8FF"/>
                                <Setter TargetName="PurpleBorder" Property="BorderBrush" Value="#7E22CE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PurpleBorder" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1.5"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE TAB DỌC SIDEBAR CHUẨN ĐỒNG BỘ UI/UX -->
        <Style x:Key="StyleSideTabBtn" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Width" Value="56"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTabNormalText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder" CornerRadius="7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ThemeCardBg}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ThemeControlBorder}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ThemeTabActiveBg}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="TabBorder" Property="Effect" Value="{StaticResource GlowCyan}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTabActiveText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NÚT VIP RED (Xóa, Cảnh báo, Nguy hiểm) -->
        <Style x:Key="StyleRedButton" TargetType="Button" BasedOn="{StaticResource StyleVipButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RedBorder" CornerRadius="7" BorderThickness="1.5"
                                BorderBrush="#EF4444" Background="#FEF2F2" RenderTransformOrigin="0.5,0.5"
                                Effect="{StaticResource GlowRed}">
                            <Grid Margin="10,0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RedBorder" Property="Background" Value="#FEE2E2"/>
                                <Setter TargetName="RedBorder" Property="BorderBrush" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RedBorder" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1.5"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- BỐ CỤC CHÍNH -->
    <Grid x:Name="MainRootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER HIỆN ĐẠI DTOOLS PRO -->
        <Border Grid.Row="0" x:Name="HeaderBorder" Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="0,0,0,1" Padding="10,8,10,8">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo Icon glow cyan -->
                        <Border Width="26" Height="26" CornerRadius="6" Margin="0,0,8,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0284C7" Offset="0"/>
                                    <GradientStop Color="#0EA5E9" Offset="0.5"/>
                                    <GradientStop Color="#38BDF8" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#0284C7" Opacity="0.4"/>
                            </Border.Effect>
                            <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="ExtraBold"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="LblAppTitle" Text="DTools Pro" FontSize="13.5" FontWeight="ExtraBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                            <TextBlock Text="AutoCAD Automation Suite" FontSize="8.5" Foreground="{DynamicResource ThemeTextSecondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Version Badge -->
                    <Border Grid.Column="1" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0284C7" Offset="0"/>
                                <GradientStop Color="#0EA5E9" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Color="#0284C7" Opacity="0.35"/>
                        </Border.Effect>
                        <TextBlock Text="v5.0 PRO" FontSize="9" FontWeight="ExtraBold" Foreground="#FFFFFF"/>
                    </Border>
                </Grid>

                <!-- SEARCH BAR -->
                <Border CornerRadius="6" BorderThickness="1" Height="30" Background="{DynamicResource ThemeControlBg}" BorderBrush="{DynamicResource ThemeControlBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ThemeAccent}"/>
                        <TextBox Grid.Column="1" x:Name="TxtSearch" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="{DynamicResource ThemeTextPrimary}" 
                                 CaretBrush="{DynamicResource ThemeAccent}"
                                 FontSize="11" 
                                 VerticalContentAlignment="Center"
                                 Padding="2,0,4,0"
                                 TextChanged="TxtSearch_TextChanged"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- THÂN: SIDEBAR + CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR DỌC (12 PHÂN HỆ ĐỒNG BỘ SLATE & ACCENT CYAN) -->
            <Border Grid.Column="0" x:Name="SidebarBorder" Background="{DynamicResource ThemeSidebarBg}" BorderBrush="{DynamicResource ThemeControlBorder}" BorderThickness="0,0,1,0" Padding="2,4">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <RadioButton x:Name="TabDoctor" Style="{StaticResource StyleSideTabBtn}" IsChecked="True" Click="Tab_Click" Tag="PanelDoctor" ToolTip="Bảo Dưỡng Bản Vẽ">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🩺" FontSize="17"/>
                                <TextBlock Text="Bác Sĩ" FontSize="9.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- TAB YQ QUICK PRO: THAO TÁC NHANH SIÊU TỐC -->
                        <RadioButton x:Name="TabYqQuick" Style="{StaticResource StyleSideTabBtn}" Click="Tab_Click" Tag="PanelYqQuick" ToolTip="Thao Tác Nhanh Siêu Tốc YQArch (Tường, Cửa, Dim, Layer, Block, Q1-Q4)">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⚡" FontSize="17"/>
                                <TextBlock Text="Nhanh YQ" FontSize="9.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabArch" Style="{StaticResource StyleSideTabBtn}" Click="Tab_Click" Tag="PanelArch" ToolTip="Kiến Trúc &amp; Nhà Cửa">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🏡" FontSize="17"/>
                                <TextBlock Text="Kiến Trúc" FontSize="9.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabStruct" Style="{StaticResource StyleSideTabBtn}" Click="Tab_Click" Tag="PanelStruct" ToolTip="Kết Cấu &amp; Cốt Thép">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🏗️" FontSize="17"/>
                                <TextBlock Text="Kết Cấu" FontSize="9.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="TabMep" Style="{StaticResource StyleSideTabBtn}" Click="Tab_Click" Tag="PanelMep" ToolTip="MEP &amp; PCCC">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="💧" FontSize="17"/>
                                <TextBlock Text="MEP" FontSize="9.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </RadioButton>

