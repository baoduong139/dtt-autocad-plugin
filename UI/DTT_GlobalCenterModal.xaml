<Window x:Class="DTT_AutoCAD_Plugin.UI.DTT_GlobalCenterModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DTools Pro - Menu Trung Tâm &amp; Xem Trước 2D/3D"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="1020" Height="670"
        MinWidth="960" MinHeight="620"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- BẢNG MÀU CHUẨN SLATE & CYAN GLOW HIỆN ĐẠI -->
        <SolidColorBrush x:Key="BgDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="CardDark" Color="#1E293B"/>
        <SolidColorBrush x:Key="BorderDark" Color="#334155"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#0284C7"/>
        <SolidColorBrush x:Key="AccentHover" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="TextLight" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>

        <!-- HIỆU ỨNG ĐỔ BÓNG -->
        <DropShadowEffect x:Key="GlowAccent" BlurRadius="20" ShadowDepth="4" Direction="270" Color="#0284C7" Opacity="0.45"/>
        <DropShadowEffect x:Key="SubtleShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.3"/>

        <!-- NÚT BẤM HIỆN ĐẠI DTOOLS -->
        <Style x:Key="StyleActionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.02" ScaleY="1.02"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1.5"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NÚT TOGGLE VIEW 2D / 3D -->
        <Style x:Key="StyleToggleBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE LISTBOX CARD ITEM -->
        <Style x:Key="StyleOptionItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="12,10" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#2D3B4E"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0EA5E9"/>
                                <Setter TargetName="CardBorder" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform X="3"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#03456C"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.8"/>
                                <Setter TargetName="CardBorder" Property="Effect" Value="{StaticResource GlowAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- KHUNG BAO NGOÀI BO GÓC & ĐỔ BÓNG -->
    <Border Margin="14" CornerRadius="14" Background="{StaticResource BgDark}" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1.8" Effect="{StaticResource GlowAccent}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/> <!-- HEADER DRAGGABLE -->
                <RowDefinition Height="*"/>  <!-- 2 CỘT CHÍNH: MENU & PREVIEW -->
                <RowDefinition Height="64"/> <!-- FOOTER ACTION BUTTONS -->
            </Grid.RowDefinitions>

            <!-- ============================================================
                 1. HEADER: THANH TIÊU ĐỀ KÉO THẢ & NÚT ĐÓNG
                 ============================================================ -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="18,0" MouseDown="Header_MouseDown" Cursor="SizeAll">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0284C7" Offset="0.0"/>
                        <GradientStop Color="#0369A1" Offset="0.5"/>
                        <GradientStop Color="#0F172A" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeaderIcon" Text="📦" FontSize="18" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtHeaderTitle" Text="THƯ VIỆN DYNAMIC BLOCKS &amp; CẤU KIỆN ĐỘNG" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <Border Background="#38BDF8" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="CENTER MODAL 2D/3D" FontSize="9" FontWeight="Bold" Foreground="#0F172A"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="Chọn cấu kiện bên trái, xoay lật xem trước 2D/3D trực quan bên phải và bấm Chèn vào CAD" 
                                   FontSize="9.5" Foreground="#BAE6FD" Margin="28,2,0,0"/>
                    </StackPanel>

                    <!-- Nút Đóng [X] -->
                    <Button Grid.Column="1" Content="✕" Width="34" Height="34" VerticalAlignment="Center"
                            Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="15" FontWeight="Bold"
                            Cursor="Hand" Click="BtnCancel_Click" ToolTip="Đóng (Phím tắt: Esc)"/>
                </Grid>
            </Border>

            <!-- ============================================================
                 2. BODY: BỐ CỤC 2 CỘT CHÍNH (MENU TRÁI + PREVIEW PHẢI)
                 ============================================================ -->
            <Grid Grid.Row="1" Margin="18,14,18,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390"/> <!-- CỘT TRÁI: MENU & BỘ LỌC -->
                    <ColumnDefinition Width="14"/>  <!-- KHOẢNG CÁCH -->
                    <ColumnDefinition Width="*"/>   <!-- CỘT PHẢI: KHUNG PREVIEW 2D/3D -->
                </Grid.ColumnDefinitions>

                <!-- ==========================================
                     CỘT TRÁI: MENU LỰA CHỌN & THÔNG SỐ
                     ========================================== -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- THANH TÌM KIẾM -->
                        <RowDefinition Height="*"/>    <!-- DANH SÁCH LỰA CHỌN -->
                        <RowDefinition Height="Auto"/> <!-- BẢNG THÔNG SỐ NHANH -->
                    </Grid.RowDefinitions>

                    <!-- Ô TÌM KIẾM NHANH -->
                    <Border Grid.Row="0" Background="{StaticResource CardDark}" CornerRadius="7" BorderBrush="{StaticResource BorderDark}" BorderThickness="1.2" Margin="0,0,0,10" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                     Foreground="{StaticResource TextLight}" FontSize="12" VerticalAlignment="Center"
                                     TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock x:Name="TxtSearchWatermark" Grid.Column="1" Text="Tìm kiếm cấu kiện hoặc lệnh..." FontSize="11.5" Foreground="#64748B" 
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource TextMuted}" FontSize="11" Cursor="Hand" Click="BtnClearSearch_Click"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- DANH SÁCH TÙY CHỌN / CẤU KIỆN (LISTBOX) -->
                    <ListBox x:Name="LstOptions" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                             ItemContainerStyle="{StaticResource StyleOptionItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="LstOptions_SelectionChanged"
                             MouseDoubleClick="LstOptions_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="#0F172A" BorderBrush="#334155" BorderThickness="1">
                                        <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Tiêu đề & phụ đề -->
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Badge nhãn -->
                                    <Border Grid.Column="2" Background="{Binding BadgeColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- BẢNG TÙY BIẾN THAM SỐ NHANH -->
                    <Border Grid.Row="2" Background="{StaticResource CardDark}" CornerRadius="8" BorderBrush="{StaticResource BorderDark}" BorderThickness="1.2" Padding="12,10" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="⚙️ THÔNG SỐ ĐIỀU CHỈNH NHANH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentHover}"/>
                                <TextBlock x:Name="TxtParamInfo" Text="Rộng: 900mm" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Hàng nút chọn kích thước nhanh -->
                            <StackPanel x:Name="PanelQuickSizes" Orientation="Horizontal" Margin="0,2,0,8">
                                <!-- Các nút chọn kích thước 800, 900, 1000... sẽ được sinh tự động -->
                            </StackPanel>

                            <!-- Hàng nút lật hướng và trạng thái góc mở -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnToggleFlip" Grid.Column="0" Style="{StaticResource StyleToggleBtn}" Height="30" Click="BtnToggleFlip_Click">
                                    <TextBlock><Run Text="🔄 "/><Run Text="Hướng: Chuẩn"/></TextBlock>
                                </Button>

                                <Button x:Name="BtnToggleAngle" Grid.Column="2" Style="{StaticResource StyleToggleBtn}" Height="30" Click="BtnToggleAngle_Click">
                                    <TextBlock><Run Text="👁️ "/><Run Text="Góc mở: 45°"/></TextBlock>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ==========================================
                     CỘT PHẢI: KHUNG PREVIEW 2D & 3D TƯƠNG TÁC
                     ========================================== -->
                <Border Grid.Column="2" Background="{StaticResource CardDark}" CornerRadius="10" BorderBrush="{StaticResource BorderDark}" BorderThickness="1.2" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/> <!-- THANH CHUYỂN CHẾ ĐỘ 2D / 3D -->
                            <RowDefinition Height="*"/>  <!-- VÙNG RENDER 2D HOẶC VIEWPORT 3D -->
                            <RowDefinition Height="Auto"/> <!-- MẸO ĐIỀU KHIỂN CHUỘT -->
                            <RowDefinition Height="Auto"/> <!-- THÔNG TIN CHI TIẾT ĐỐI TƯỢNG -->
                        </Grid.RowDefinitions>

                        <!-- THANH CÔNG CỤ PREVIEW (2D FLAT / 3D INTERACTIVE) -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👁️ " FontSize="14"/>
                                <TextBlock Text="KHUNG PREVIEW TRỰC QUAN" FontSize="11.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                            </StackPanel>

                            <!-- Bộ nút chuyển đổi 2D / 3D / Reset Camera -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnView2D" Content="📐 Dạng 2D (Flat)" Style="{StaticResource StyleToggleBtn}" Margin="0,0,6,0" Click="BtnView2D_Click"/>
                                <Button x:Name="BtnView3D" Content="🧊 Mô Hình 3D (Orbit)" Style="{StaticResource StyleToggleBtn}" Margin="0,0,6,0" Click="BtnView3D_Click"/>
                                <Button x:Name="BtnResetView" Content="🔄 Reset Góc" Style="{StaticResource StyleToggleBtn}" Click="BtnResetView_Click" ToolTip="Đưa góc nhìn 3D về mặc định"/>
                            </StackPanel>
                        </Grid>

                        <!-- VÙNG HIỂN THỊ PREVIEW CHÍNH -->
                        <Border Grid.Row="1" Background="#0B132B" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1.5" Margin="0,6,0,8" ClipToBounds="True">
                            <Grid>
                                <!-- 1. VIEWPORT 3D (INTERACTIVE 3D ORBIT / ZOOM / PAN) -->
                                <Viewport3D x:Name="Vp3D"
                                            MouseDown="Vp3D_MouseDown"
                                            MouseMove="Vp3D_MouseMove"
                                            MouseUp="Vp3D_MouseUp"
                                            MouseWheel="Vp3D_MouseWheel"
                                            Cursor="Hand">
                                    <!-- Camera 3D và Ánh sáng được tạo tự động trong code-behind -->
                                </Viewport3D>

                                <!-- 2. CANVAS VẼ HÌNH 2D (FLAT VIEW) -->
                                <Border x:Name="Border2D" Background="#0F172A" Visibility="Collapsed">
                                    <Canvas x:Name="Canvas2D" Width="480" Height="300" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- THANH GỢI Ý THAO TÁC CHUỘT 3D -->
                        <Border Grid.Row="2" Background="#131F37" CornerRadius="5" Padding="10,4" Margin="0,0,0,8">
                            <TextBlock FontSize="9.5" Foreground="#38BDF8" HorizontalAlignment="Center">
                                <Run Text="🖱️ "/><Run FontWeight="Bold" Text="Chuột trái:"/> Xoay 3D (Orbit) | 
                                <Run FontWeight="Bold" Text=" Chuột phải:"/> Di chuyển (Pan) | 
                                <Run FontWeight="Bold" Text=" Con lăn:"/> Phóng to / Thu nhỏ (Zoom)
                            </TextBlock>
                        </Border>

                        <!-- THÔNG TIN TÓM TẮT ĐỐI TƯỢNG ĐANG CHỌN -->
                        <Border Grid.Row="3" Background="#18233C" CornerRadius="6" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TxtSelectedItemName" Text="Cửa Đi Động (Architectural_Doors)" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock x:Name="TxtSelectedDesc" Text="File: Blocks/Architectural_Doors.dwg • Kích thước: 900x2200mm" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#0284C7" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTargetCmd" Text="LỆNH CAD: DT_DOOR" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================
                 3. FOOTER: NÚT THỰC THI CHÈN VÀO CAD & HỦY BỎ
                 ============================================================ -->
            <Border Grid.Row="2" Background="#0B132B" CornerRadius="0,0,12,12" BorderBrush="#1E293B" BorderThickness="0,1.5,0,0" Padding="18,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Phím tắt hướng dẫn -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="ESC" FontSize="9" FontWeight="Bold" Foreground="#94A3B8"/>
                        </Border>
                        <TextBlock Text="Đóng" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="ENTER" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                        <TextBlock Text="Chèn ngay" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Nút Hủy và Nút Chèn vào CAD -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="✕ HỦY BỎ (Esc)" Style="{StaticResource StyleActionButton}" 
                                Background="#334155" BorderBrush="#475569" Margin="0,0,12,0" Width="140"
                                Click="BtnCancel_Click"/>

                        <Button x:Name="BtnConfirm" Style="{StaticResource StyleActionButton}" 
                                Background="#0284C7" BorderBrush="#38BDF8" Width="260"
                                Click="BtnConfirm_Click" Effect="{StaticResource GlowAccent}">
                            <TextBlock>
                                <Run Text="⚡ " FontSize="14"/>
                                <Run Text="CHÈN VÀO BẢN VẼ (Enter)" FontWeight="Bold"/>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
