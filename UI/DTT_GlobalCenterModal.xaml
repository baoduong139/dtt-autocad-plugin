<Window x:Class="DTT_AutoCAD_Plugin.UI.DTT_GlobalCenterModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DTools Pro - Thư Viện Cấu Kiện Động &amp; Dynamic Blocks"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="760" Height="510"
        MinWidth="680" MinHeight="450"
        FontFamily="Segoe UI, Tahoma, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- BẢNG MÀU CHUẨN SLATE & CYAN GLOW HIỆN ĐẠI -->
        <SolidColorBrush x:Key="BgDark" Color="#0F172A"/>
        <SolidColorBrush x:Key="CardDark" Color="#1E293B"/>
        <SolidColorBrush x:Key="BorderDark" Color="#334155"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#0284C7"/>
        <SolidColorBrush x:Key="AccentHover" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="TextLight" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>

        <!-- HIỆU ỨNG ĐỔ BÓNG -->
        <DropShadowEffect x:Key="GlowAccent" BlurRadius="16" ShadowDepth="3" Direction="270" Color="#0284C7" Opacity="0.4"/>
        <DropShadowEffect x:Key="SubtleShadow" BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.25"/>

        <!-- NÚT BẤM HIỆN ĐẠI GỌN GÀNG -->
        <Style x:Key="StyleActionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NÚT TOGGLE VIEW 2D / 3D GỌN GÀNG -->
        <Style x:Key="StyleToggleBtn" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE LISTBOX CARD ITEM NHỎ GỌN -->
        <Style x:Key="StyleOptionItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="8,6" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#2D3B4E"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#03456C"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- KHUNG BAO NGOÀI BO GÓC & ĐỔ BÓNG GỌN GÀNG -->
    <Border Margin="10" CornerRadius="10" Background="{StaticResource BgDark}" BorderBrush="{StaticResource AccentCyan}" BorderThickness="1.2" Effect="{StaticResource GlowAccent}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/> <!-- HEADER DRAGGABLE -->
                <RowDefinition Height="*"/>  <!-- 2 CỘT CHÍNH: MENU & PREVIEW -->
                <RowDefinition Height="46"/> <!-- FOOTER ACTION BUTTONS -->
            </Grid.RowDefinitions>

            <!-- ============================================================
                 1. HEADER: THANH TIÊU ĐỀ KÉO THẢ & NÚT ĐÓNG
                 ============================================================ -->
            <Border Grid.Row="0" CornerRadius="9,9,0,0" Padding="14,0" MouseDown="Header_MouseDown" Cursor="SizeAll">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0284C7" Offset="0.0"/>
                        <GradientStop Color="#0369A1" Offset="0.6"/>
                        <GradientStop Color="#0F172A" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderIcon" Text="📦" FontSize="15" Foreground="#FFFFFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtHeaderTitle" Text="THƯ VIỆN DYNAMIC BLOCKS DTOOLS" FontSize="12.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border Background="#38BDF8" CornerRadius="3" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="COMPACT 2D/3D" FontSize="8.5" FontWeight="Bold" Foreground="#0F172A"/>
                        </Border>
                    </StackPanel>

                    <!-- Nút Đóng [X] -->
                    <Button Grid.Column="1" Content="✕" Width="28" Height="28" VerticalAlignment="Center"
                            Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" FontSize="13" FontWeight="Bold"
                            Cursor="Hand" Click="BtnCancel_Click" ToolTip="Đóng (Phím tắt: Esc)"/>
                </Grid>
            </Border>

            <!-- ============================================================
                 2. BODY: BỐ CỤC 2 CỘT CHÍNH (MENU TRÁI + PREVIEW PHẢI)
                 ============================================================ -->
            <Grid Grid.Row="1" Margin="12,10,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290"/> <!-- CỘT TRÁI: MENU & BỘ LỌC -->
                    <ColumnDefinition Width="10"/>  <!-- KHOẢNG CÁCH -->
                    <ColumnDefinition Width="*"/>   <!-- CỘT PHẢI: KHUNG PREVIEW 2D/3D -->
                </Grid.ColumnDefinitions>

                <!-- ==========================================
                     CỘT TRÁI: MENU LỰA CHỌN & THÔNG SỐ
                     ========================================== -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- THANH TÌM KIẾM -->
                        <RowDefinition Height="*"/>    <!-- DANH SÁCH LỰA CHỌN -->
                        <RowDefinition Height="Auto"/> <!-- BẢNG THÔNG SỐ NHANH -->
                    </Grid.RowDefinitions>

                    <!-- Ô TÌM KIẾM NHANH -->
                    <Border Grid.Row="0" Background="{StaticResource CardDark}" CornerRadius="5" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Margin="0,0,0,6" Padding="6,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                     Foreground="{StaticResource TextLight}" FontSize="11" VerticalAlignment="Center"
                                     TextChanged="TxtSearch_TextChanged"/>
                            <TextBlock x:Name="TxtSearchWatermark" Grid.Column="1" Text="Tìm kiếm cấu kiện hoặc lệnh..." FontSize="10.5" Foreground="#64748B" 
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource TextMuted}" FontSize="10" Cursor="Hand" Click="BtnClearSearch_Click"
                                    Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- DANH SÁCH TÙY CHỌN / CẤU KIỆN (LISTBOX) -->
                    <ListBox x:Name="LstOptions" Grid.Row="1" Background="Transparent" BorderThickness="0" 
                             ItemContainerStyle="{StaticResource StyleOptionItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="LstOptions_SelectionChanged"
                             MouseDoubleClick="LstOptions_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="4" Background="#0F172A" BorderBrush="#334155" BorderThickness="1">
                                        <TextBlock Text="{Binding Icon}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Tiêu đề & phụ đề -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Badge nhãn -->
                                    <Border Grid.Column="2" Background="{Binding BadgeColor}" CornerRadius="3" Padding="4,1.5" VerticalAlignment="Center" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding Badge}" FontSize="8" FontWeight="Bold" Foreground="#FFFFFF"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- BẢNG TÙY BIẾN THAM SỐ NHANH -->
                    <Border Grid.Row="2" Background="{StaticResource CardDark}" CornerRadius="6" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="8,6" Margin="0,6,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="⚙️ THÔNG SỐ ĐIỀU CHỈNH NHANH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentHover}"/>
                                <TextBlock x:Name="TxtParamInfo" Text="Rộng: 900mm" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Hàng nút chọn kích thước nhanh -->
                            <StackPanel x:Name="PanelQuickSizes" Orientation="Horizontal" Margin="0,1,0,5">
                                <!-- Các nút chọn kích thước 800, 900, 1000... sẽ được sinh tự động -->
                            </StackPanel>

                            <!-- Hàng nút lật hướng và trạng thái góc mở -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnToggleFlip" Grid.Column="0" Style="{StaticResource StyleToggleBtn}" Height="25" Click="BtnToggleFlip_Click">
                                    <TextBlock><Run Text="🔄 "/><Run Text="Hướng: Chuẩn"/></TextBlock>
                                </Button>

                                <Button x:Name="BtnToggleAngle" Grid.Column="2" Style="{StaticResource StyleToggleBtn}" Height="25" Click="BtnToggleAngle_Click">
                                    <TextBlock><Run Text="👁️ "/><Run Text="Góc: 45°"/></TextBlock>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ==========================================
                     CỘT PHẢI: KHUNG PREVIEW 2D & 3D TƯƠNG TÁC
                     ========================================== -->
                <Border Grid.Column="2" Background="{StaticResource CardDark}" CornerRadius="8" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/> <!-- THANH CHUYỂN CHẾ ĐỘ 2D / 3D -->
                            <RowDefinition Height="*"/>  <!-- VÙNG RENDER 2D HOẶC VIEWPORT 3D -->
                            <RowDefinition Height="Auto"/> <!-- MẸO ĐIỀU KHIỂN CHUỘT (CHỈ HIỆN Ở 3D) -->
                            <RowDefinition Height="Auto"/> <!-- THÔNG TIN CHI TIẾT ĐỐI TƯỢNG -->
                        </Grid.RowDefinitions>

                        <!-- THANH CÔNG CỤ PREVIEW (2D FLAT / 3D INTERACTIVE) -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="👁️ " FontSize="12"/>
                                <TextBlock Text="XEM TRƯỚC BẢN VẼ" FontSize="10.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                            </StackPanel>

                            <!-- Bộ nút chuyển đổi 2D / 3D / Reset Camera -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnView2D" Content="📐 2D Mặt Bằng" Style="{StaticResource StyleToggleBtn}" Margin="0,0,4,0" Click="BtnView2D_Click"/>
                                <Button x:Name="BtnView3D" Content="🧊 Mô Hình 3D" Style="{StaticResource StyleToggleBtn}" Margin="0,0,4,0" Click="BtnView3D_Click"/>
                                <Button x:Name="BtnResetView" Content="🔄 Reset" Style="{StaticResource StyleToggleBtn}" Click="BtnResetView_Click" ToolTip="Đưa góc nhìn 3D về mặc định"/>
                            </StackPanel>
                        </Grid>

                        <!-- VÙNG HIỂN THỊ PREVIEW CHÍNH -->
                        <Border Grid.Row="1" Background="#0B132B" CornerRadius="6" BorderBrush="#1E293B" BorderThickness="1" Margin="0,4,0,5" ClipToBounds="True">
                            <Grid>
                                <!-- 1. CANVAS VẼ HÌNH 2D (FLAT VIEW - MẶC ĐỊNH MỞ NHANH) -->
                                <Border x:Name="Border2D" Background="#0B132B" Visibility="Visible">
                                    <Canvas x:Name="Canvas2D" Width="380" Height="240" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- 2. VIEWPORT 3D (INTERACTIVE 3D ORBIT / ZOOM / PAN) -->
                                <Viewport3D x:Name="Vp3D"
                                            Visibility="Collapsed"
                                            MouseDown="Vp3D_MouseDown"
                                            MouseMove="Vp3D_MouseMove"
                                            MouseUp="Vp3D_MouseUp"
                                            MouseWheel="Vp3D_MouseWheel"
                                            Cursor="Hand">
                                    <!-- Camera 3D và Ánh sáng được tạo tự động trong code-behind -->
                                </Viewport3D>
                            </Grid>
                        </Border>

                        <!-- THANH GỢI Ý THAO TÁC CHUỘT 3D -->
                        <Border x:Name="Border3DHint" Grid.Row="2" Background="#131F37" CornerRadius="4" Padding="6,2" Margin="0,0,0,5" Visibility="Collapsed">
                            <TextBlock FontSize="8.5" Foreground="#38BDF8" HorizontalAlignment="Center">
                                <Run Text="🖱️ "/><Run FontWeight="Bold" Text="Chuột trái:"/> Xoay | 
                                <Run FontWeight="Bold" Text=" Chuột phải:"/> Di chuyển | 
                                <Run FontWeight="Bold" Text=" Con lăn:"/> Zoom
                            </TextBlock>
                        </Border>

                        <!-- THÔNG TIN TÓM TẮT ĐỐI TƯỢNG ĐANG CHỌN -->
                        <Border Grid.Row="3" Background="#18233C" CornerRadius="5" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSelectedItemName" Text="Cửa Đi Động (Architectural_Doors)" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock x:Name="TxtSelectedDesc" Text="Blocks/Architectural_Doors.dwg • Kích thước: 900x2200mm" FontSize="8.5" Foreground="#94A3B8" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#0284C7" CornerRadius="3" Padding="6,2.5" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTargetCmd" Text="LỆNH: DT_DOOR" FontSize="8.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================
                 3. FOOTER: NÚT THỰC THI CHÈN VÀO CAD & HỦY BỎ
                 ============================================================ -->
            <Border Grid.Row="2" Background="#0B132B" CornerRadius="0,0,9,9" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="14,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Phím tắt hướng dẫn -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#1E293B" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                            <TextBlock Text="ESC" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8"/>
                        </Border>
                        <TextBlock Text="Đóng" FontSize="9.5" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <Border Background="#1E293B" CornerRadius="3" Padding="4,1" Margin="0,0,4,0">
                            <TextBlock Text="ENTER" FontSize="8.5" FontWeight="Bold" Foreground="#38BDF8"/>
                        </Border>
                        <TextBlock Text="Chèn ngay (1 Lần)" FontSize="9.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Nút Hủy và Nút Chèn vào CAD -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="✕ HỦY (Esc)" Style="{StaticResource StyleActionButton}" 
                                Background="#334155" BorderBrush="#475569" Margin="0,0,8,0" Width="95"
                                Click="BtnCancel_Click"/>

                        <Button x:Name="BtnConfirm" Style="{StaticResource StyleActionButton}" 
                                Background="#0284C7" BorderBrush="#38BDF8" Width="185"
                                Click="BtnConfirm_Click" Effect="{StaticResource GlowAccent}">
                            <TextBlock>
                                <Run Text="⚡ " FontSize="12"/>
                                <Run Text="CHÈN VÀO BẢN VẼ (Enter)" FontWeight="Bold"/>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>