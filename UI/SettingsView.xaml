<UserControl x:Class="DTT_AutoCAD_Plugin.UI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="320"
             FontFamily="Segoe UI, Tahoma, sans-serif"
             Background="{DynamicResource ThemePaletteBg}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             x:Name="RootSettingsControl">

    <!-- ============================================================
         RESOURCE DICTIONARY: HỆ THỐNG MÀU SẮC CHUẨN SLATE & ACCENT BLUE/CYAN
         ============================================================ -->
    <UserControl.Resources>
        <!-- BẢNG MÀU GIAO DIỆN HIỆN ĐẠI (DARK SLATE PRO DEFAULT) -->
        <SolidColorBrush x:Key="ThemePaletteBg" Color="#0F172A"/>      <!-- Nền Palette chính (Slate 900) -->
        <SolidColorBrush x:Key="ThemeCardBg" Color="#1E293B"/>         <!-- Nền Card cài đặt dịu mắt (Slate 800) -->
        <SolidColorBrush x:Key="ThemeCardBorder" Color="#334155"/>     <!-- Đường viền Card tinh tế (Slate 700) -->
        <SolidColorBrush x:Key="ThemeTextPrimary" Color="#F8FAFC"/>    <!-- Chữ tiêu đề / nội dung chính (Slate 50) -->
        <SolidColorBrush x:Key="ThemeTextSecondary" Color="#94A3B8"/>  <!-- Chữ ghi chú phụ (Slate 400) -->
        <SolidColorBrush x:Key="ThemeAccent" Color="#0EA5E9"/>         <!-- Màu nhấn chủ đạo DTools (Sky Blue 500) -->
        <SolidColorBrush x:Key="ThemeAccentHover" Color="#38BDF8"/>    <!-- Màu nhấn khi hover (Sky Blue 400) -->
        <SolidColorBrush x:Key="ThemeControlBg" Color="#0F172A"/>      <!-- Nền Control ComboBox / Info Card -->
        <SolidColorBrush x:Key="ThemeControlBorder" Color="#334155"/>  <!-- Viền Control -->

        <!-- HIỆU ỨNG ĐỔ BÓNG MỊN -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="6" ShadowDepth="1.5" Direction="270" Color="#000000" Opacity="0.25"/>
        <DropShadowEffect x:Key="GlowAccent" BlurRadius="8" ShadowDepth="0" Color="#0EA5E9" Opacity="0.4"/>

        <!-- ============================================================
             STYLE COMBOBOX HIỆN ĐẠI (BO TRÒN GÓC 6PX, BORDER MẢNH NHẸ)
             ============================================================ -->
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeControlBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Border" 
                                                CornerRadius="6" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="24"/>
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow" Grid.Column="1" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                      Data="M 0 0 L 4 4 L 8 0 Z" 
                                                      Fill="{DynamicResource ThemeTextSecondary}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeAccent}"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource ThemeAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="{DynamicResource ThemeCardBg}" 
                                            BorderBrush="{DynamicResource ThemeControlBorder}" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Margin="0,2,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="#000000" Opacity="0.4"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE COMBOBOX ITEM -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================
             STYLE NÚT HÀNH ĐỘNG CARD (HOVER MƯỢT, BO GÓC 6PX, ICON CANH CHUẨN)
             ============================================================ -->
        <Style x:Key="CardActionButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                CornerRadius="6" 
                                Background="{DynamicResource ThemeControlBg}" 
                                BorderBrush="{DynamicResource ThemeControlBorder}" 
                                BorderThickness="1" 
                                Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeAccent}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeAccentHover}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NÚT DỌN RÁC / NGUY HIỂM (HOVER ĐỎ NỔI BẬT) -->
        <Style x:Key="CardDangerButtonStyle" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" 
                                CornerRadius="6" 
                                Background="{DynamicResource ThemeControlBg}" 
                                BorderBrush="{DynamicResource ThemeControlBorder}" 
                                BorderThickness="1" 
                                Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DC2626"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#EF4444"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ============================================================
         BỐ CỤC CHÍNH BẢNG CÀI ĐẶT (SETTINGS VIEW)
         ============================================================ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,6,8,8">
        <StackPanel>
            <!-- TIÊU ĐỀ CHÍNH HIỆN ĐẠI (ACCENT SKY BLUE ĐỒNG BỘ LOGO) -->
            <TextBlock Text="⚙️ CÀI ĐẶT HỆ THỐNG DTT PRO" 
                       FontSize="12" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource ThemeAccent}" 
                       Margin="2,4,0,8"/>

            <!-- CARD 1: CỠ CHỮ GIAO DIỆN -->
            <Border CornerRadius="8" 
                    BorderBrush="{DynamicResource ThemeCardBorder}" 
                    BorderThickness="1" 
                    Background="{DynamicResource ThemeCardBg}" 
                    Effect="{StaticResource CardShadow}"
                    Padding="12" 
                    Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🔤 " FontSize="13" Foreground="{DynamicResource ThemeAccent}"/>
                        <TextBlock Text="CỠ CHỮ GIAO DIỆN:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ComboBox x:Name="CmbFontSize" 
                              Style="{StaticResource ModernComboBoxStyle}" 
                              SelectedIndex="1" 
                              SelectionChanged="CmbFontSize_SelectionChanged">
                        <ComboBoxItem Content="Nhỏ (10 px) - Compact Mode"/>
                        <ComboBoxItem Content="Tiêu Chuẩn (11.5 px) - Normal"/>
                        <ComboBoxItem Content="Lớn (13.5 px) - Large Mode"/>
                        <ComboBoxItem Content="Rất Lớn (15 px) - Extra Large"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- CARD 2: CHỦ ĐỀ GIAO DIỆN (THEME DYNAMIC) -->
            <Border CornerRadius="8" 
                    BorderBrush="{DynamicResource ThemeCardBorder}" 
                    BorderThickness="1" 
                    Background="{DynamicResource ThemeCardBg}" 
                    Effect="{StaticResource CardShadow}"
                    Padding="12" 
                    Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🌓 " FontSize="13" Foreground="{DynamicResource ThemeAccent}"/>
                        <TextBlock Text="CHỦ ĐỀ GIAO DIỆN (THEME):" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ComboBox x:Name="CmbTheme" 
                              Style="{StaticResource ModernComboBoxStyle}" 
                              SelectedIndex="0" 
                              SelectionChanged="CmbTheme_SelectionChanged">
                        <ComboBoxItem Content="🌑 Dark Slate Pro (Xám Đậm &amp; Xanh Dương)"/>
                        <ComboBoxItem Content="☀️ Light Studio (Trắng Sáng &amp; Xanh)"/>
                        <ComboBoxItem Content="🌌 Cyberpunk Dark (Navy &amp; Neon Cyan)"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- CARD 3: NGÔN NGỮ HIỂN THỊ (LANGUAGE) -->
            <Border CornerRadius="8" 
                    BorderBrush="{DynamicResource ThemeCardBorder}" 
                    BorderThickness="1" 
                    Background="{DynamicResource ThemeCardBg}" 
                    Effect="{StaticResource CardShadow}"
                    Padding="12" 
                    Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🌐 " FontSize="13" Foreground="{DynamicResource ThemeAccent}"/>
                        <TextBlock Text="NGÔN NGỮ (LANGUAGE):" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ComboBox x:Name="CmbLanguage" 
                              Style="{StaticResource ModernComboBoxStyle}" 
                              SelectedIndex="0" 
                              SelectionChanged="CmbLanguage_SelectionChanged">
                        <ComboBoxItem Content="🇻🇳 Tiếng Việt (Vietnamese Standard)"/>
                        <ComboBoxItem Content="🇬🇧 English (International CAD)"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- CARD 4: QUẢN LÝ HỆ THỐNG & MENUBAR DTOOLS -->
            <Border CornerRadius="8" 
                    BorderBrush="{DynamicResource ThemeCardBorder}" 
                    BorderThickness="1" 
                    Background="{DynamicResource ThemeCardBg}" 
                    Effect="{StaticResource CardShadow}"
                    Padding="12" 
                    Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="🛠️ " FontSize="13" Foreground="{DynamicResource ThemeAccent}"/>
                        <TextBlock Text="QUẢN LÝ HỆ THỐNG &amp; MENU DTOOLS:" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Hàng 2 nút tiện ích -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" 
                                Style="{StaticResource CardActionButtonStyle}" 
                                Click="BtnAction_Click" 
                                Tag="DT_MENU" 
                                ToolTip="Cập nhật hoặc hiển thị lại MenuBar 'DTools Pro' trên AutoCAD">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📋 " FontSize="12"/>
                                <TextBlock Text="Cập Nhật MenuBar"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" 
                                Style="{StaticResource CardActionButtonStyle}" 
                                Click="BtnAction_Click" 
                                Tag="DT_YQREFIX" 
                                ToolTip="Khôi phục và nạp lại Menu YQArch Tiếng Việt">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🩺 " FontSize="12"/>
                                <TextBlock Text="Sửa Lỗi YQArch"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Nút dọn rác DWG toàn diện -->
                    <Button Style="{StaticResource CardDangerButtonStyle}" 
                            Click="BtnAction_Click" 
                            Tag="DT_CLEAN" 
                            ToolTip="Dọn dẹp rác, xóa RegApps, nét độ dài 0 và sửa lỗi database">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🧹 " FontSize="12"/>
                            <TextBlock Text="Dọn Rác &amp; Sửa Lỗi DWG (DT_CLEAN)"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- CARD 5: THÔNG TIN PHIÊN BẢN & BẢN QUYỀN -->
            <Border CornerRadius="8" 
                    BorderBrush="{DynamicResource ThemeControlBorder}" 
                    BorderThickness="1" 
                    Background="{DynamicResource ThemeControlBg}" 
                    Padding="12" 
                    Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="DTT CAD TOOLSET PRO v2026" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeAccent}"/>
                    <TextBlock Text="Native WPF | AutoCAD 2020-2026 | .NET Framework 4.8" FontSize="9" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0"/>
                    <TextBlock Text="Tất cả chức năng 100% tiếng Việt - Sẵn sàng thực thi 1-Click" FontSize="9" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
